{
  "name": "cinebridge-recomendacao",
  "version": "1.0.0",
  "description": "Microservico de recomendacao e orquestracao de equipes para producoes audiovisuais independentes",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "node -r ts-node/register src/seed.ts",
    "test:orquestrador": "node -r ts-node/register src/testar-orquestrador.ts",
    "test:visitors": "node -r ts-node/register src/testar-visitors.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}

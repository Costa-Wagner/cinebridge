DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cinebridge
PORT=3000
# Decoradores da recomendacao (ordem de aplicacao; vazio = nenhum). Ex.: CACHE,AUDITORIA,COMPRESSAO
DECORADORES=CACHE
# RabbitMQ (cinebridge-mq)
MQ_USER=guest
MQ_PASSWORD=guest
MQ_HOST=localhost
MQ_PORT=5672
# Barramento de eventos: memoria (EventEmitter) ou rabbitmq
BARRAMENTO=memoria

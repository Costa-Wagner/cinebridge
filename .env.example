DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cinebridge
PORT=3000
# Decoradores da recomendacao (ordem de aplicacao; vazio = nenhum). Ex.: CACHE,AUDITORIA,COMPRESSAO
DECORADORES=CACHE
# RabbitMQ (cinebridge-mq)
MQ_USER=guest
MQ_PASSWORD=guest
MQ_HOST=localhost
MQ_PORT=5672
# Barramento de eventos: memoria (EventEmitter) ou rabbitmq
BARRAMENTO=memoria
# Origem do cadastro de profissionais: local (Postgres da api) ou mq (cinebridge-profissionais via RabbitMQ)
PROFISSIONAIS_VIA=local
# cinebridge-projetos (banco proprio; padroes apontam para o projetos-db do compose)
PROJETOS_DB_HOST=localhost
PROJETOS_DB_PORT=5433
PROJETOS_DB_NAME=projetos
# cinebridge-profissionais (usa o profissionais-db) e cinebridge-notificacoes (usa o notificacoes-db)
PROFISSIONAIS_DB_HOST=localhost
PROFISSIONAIS_DB_PORT=5432
PROFISSIONAIS_DB_NAME=profissionais
NOTIFICACOES_DB_HOST=localhost
NOTIFICACOES_DB_PORT=5435
NOTIFICACOES_DB_NAME=notificacoes
# Portas HTTP dos servicos (a api continua em PORT)
PROFISSIONAIS_PORT=3001
PROJETOS_PORT=3002
NOTIFICACOES_PORT=3003
